{{ ansible_managed | comment }}

# Forked from prometheus.prometheus.process_exporter's own
# process_exporter.service.j2 template (version {{ process_exporter_version }}
# at the time this was forked) to add support for the --recheck, --children,
# --threads, and --gather-smaps flags, which that role does not expose.
# If upstream adds native support for these, this fork can be dropped in
# favor of their template again.

[Unit]
Description=Prometheus Process Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ process_exporter_system_user }}
Group={{ process_exporter_system_group }}
{% set extra_flags = [] %}
{% if process_exporter_recheck is defined %}{% set _ = extra_flags.append("'--recheck=" ~ (process_exporter_recheck | string | lower) ~ "'") %}{% endif %}
{% if process_exporter_children is defined %}{% set _ = extra_flags.append("'--children=" ~ (process_exporter_children | string | lower) ~ "'") %}{% endif %}
{% if process_exporter_threads is defined %}{% set _ = extra_flags.append("'--threads=" ~ (process_exporter_threads | string | lower) ~ "'") %}{% endif %}
{% if process_exporter_gather_smaps is defined %}{% set _ = extra_flags.append("'--gather-smaps=" ~ (process_exporter_gather_smaps | string | lower) ~ "'") %}{% endif %}
ExecStart={{ process_exporter_binary_install_dir }}/process-exporter \
{% if process_exporter_names != [] -%}
    '--config.path={{ process_exporter_config_dir }}/config.yml' \
{% endif -%}
{% if process_exporter_tls_server_config | length > 0 or process_exporter_http_server_config | length > 0 or process_exporter_basic_auth_users | length > 0 %}
    '--web.config.file={{ process_exporter_config_dir }}/web_config.yml' \
{% endif %}
{% if process_exporter_recheck_time_limit != "0" and process_exporter_version is version('0.8.0', '>=') %}
    '--recheck-with-time-limit={{ process_exporter_recheck_time_limit }}' \
{% endif %}
    '--web.listen-address={{ process_exporter_web_listen_address }}' \
    '--web.telemetry-path={{ process_exporter_web_telemetry_path }}'{{ (' \\\n    ' ~ (extra_flags | join(" \\\n    "))) if extra_flags | length > 0 else '' }}

SyslogIdentifier=process_exporter
Restart=always
RestartSec=1
StartLimitInterval=0

{% set ns = namespace(protect_home = 'yes') %}
{% for m in ansible_facts['mounts'] if m.mount.startswith('/home') %}
{%   set ns.protect_home = 'read-only' %}
{% endfor %}
ProtectHome={{ ns.protect_home }}
NoNewPrivileges=yes

{% if (ansible_facts.packages.systemd | first).version is version('232', '>=') %}
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=yes
{% else %}
ProtectSystem=full
{% endif %}

[Install]
WantedBy=multi-user.target
