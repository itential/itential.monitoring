// {{ ansible_managed }}
// Inventory host: {{ inventory_hostname }}

// ─── Loki Push Endpoint ──────────────────────────────────────────────────────
loki.write "default" {
  endpoint {
    url = "{{ alloy_loki_url }}/loki/api/v1/push"
  }
}

// ─── Systemd Journal ─────────────────────────────────────────────────────────
loki.source.journal "journal" {
  max_age    = "12h"
  labels     = {
    job  = "journal",
    host = "{{ inventory_hostname }}",
  }
  forward_to = [loki.relabel.journal_unit.receiver]
}

loki.relabel "journal_unit" {
  forward_to = [loki.write.default.receiver]

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}
{% if alloy_log_paths | length > 0 %}

// ─── Application Log Files ───────────────────────────────────────────────────
local.file_match "app_logs" {
  path_targets = [
{% for log in alloy_log_paths %}
    {
      __path__ = "{{ log.path }}",
      job      = "{{ log.job }}",
      host     = "{{ inventory_hostname }}",
    },
{% endfor %}
  ]
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.write.default.receiver]
}
{% endif %}
