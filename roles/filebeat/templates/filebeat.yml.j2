# ======================== Filebeat inputs ========================
filebeat.config.inputs:
  enabled: true
  path: /etc/filebeat/inputs.d/*.yml
  reload.enabled: true
  reload.period: 10s

# ======================== Paths ========================
path.data: {{ filebeat_data_path }}
path.logs: {{ filebeat_log_path }}

# ======================== Kibana ========================
setup.kibana:
  host: "{{ filebeat_setup_kibana_host }}"

# ======================== Outputs ========================
{% if filebeat_output_logstash_enabled | bool %}
output.logstash:
  hosts: {{ filebeat_output_logstash_hosts | to_json }}
{% if filebeat_tls_enabled | bool %}
  ssl:
    certificate_authorities: ["{{ filebeat_tls_ca_cert_dest }}"]
    certificate: "{{ filebeat_tls_cert_dest }}"
    key: "{{ filebeat_tls_key_dest }}"
{% endif %}
{% elif filebeat_output_elasticsearch_enabled | bool %}
output.elasticsearch:
  hosts: {{ filebeat_output_elasticsearch_hosts | to_json }}
  index: "{{ filebeat_output_elasticsearch_index }}"
{% if filebeat_tls_enabled | bool %}
  ssl:
    certificate_authorities: ["{{ filebeat_tls_ca_cert_dest }}"]
    certificate: "{{ filebeat_tls_cert_dest }}"
    key: "{{ filebeat_tls_key_dest }}"
{% endif %}
{% endif %}
