{% for entry in filebeat_platform_log_paths %}
- type: log
  enabled: true
  paths:
    - {{ entry.path }}
  json.keys_under_root: true
  json.add_error_key: true
  fields:
    app: {{ entry.app }}
    environment: {{ filebeat_environment }}
  fields_under_root: true
{% endfor %}
