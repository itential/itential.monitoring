# --- Syslog ---
- type: filestream
  id: syslog
  enabled: true
  paths:
{% for path in filebeat_syslog_log_paths %}
    - {{ path }}
{% endfor %}
  fields:
    app: syslog
    log_type: syslog
    environment: {{ filebeat_environment }}
  fields_under_root: true
