# /etc/logstash/conf.d/itential.conf

input {
  beats {
    port => {{ logstash_beats_port }}
{% if logstash_tls_enabled | bool %}
    ssl_enabled => true
    ssl_certificate => "{{ logstash_tls_cert_dest }}"
    ssl_key => "{{ logstash_tls_key_dest }}"
    ssl_certificate_authorities => ["{{ logstash_tls_ca_cert_dest }}"]
{% else %}
    ssl_enabled => false
{% endif %}
  }
}

filter {

  # Fallback for events arriving without an app field
  if ![app] {
    mutate {
      add_field => { "app" => "unknown" }
    }
  }

  # Populate top-level hostname field — used as a Loki label by the Loki output below
  mutate {
    add_field => { "hostname" => "%{[host][name]}" }
  }

  # IAP sub-process logs
  if [app] == "itential-platform-service" {

    # Extract sub-process name from log file path
    grok {
      match => {
        "[log][file][path]" => "/var/log/itential/platform/%{GREEDYDATA:itential.process}"
      }
    }
    mutate {
      gsub => ["itential.process", "\.log$", ""]
    }

    # Unwrap message from JSON array string.
    # IAP sub-process logs are wrapped in a JSON array with two shapes:
    #   ["message text"]                                    — plain string element
    #   [{"message":"...","context":{"key":"val",...}}]     — object element with context
    # Must run before sub-process specific filters that match on message content.
    ruby {
      code => '
        msg = event.get("@message") || event.get("message")
        if msg && msg.start_with?("[")
          begin
            parsed = JSON.parse(msg)
            if parsed.is_a?(Array) && !parsed.empty?
              first = parsed[0]
              if first.is_a?(Hash)
                event.set("message", first["message"]) if first["message"]
                if first["context"].is_a?(Hash)
                  first["context"].each do |k, v|
                    event.set("itential.#{k}", v)
                  end
                end
              elsif first.is_a?(String)
                event.set("message", first)
              end
              event.remove("@message")
            end
          rescue
            # not valid JSON — leave message as-is
          end
        end
      '
    }

    # Promote @fields subkeys to top level
    if [@fields] {
      mutate {
        rename => { "[@fields][@level]"  => "log.level"      }
        rename => { "[@fields][@origin]" => "itential.origin" }
        remove_field => ["@fields"]
      }
    }
  }

  # IAP main platform process
  if [app] == "itential-platform-main" {
    mutate { add_field => { "itential.process" => "platform" } }
  }

  # IAP webserver
  if [app] == "itential-platform-web" {
    mutate { add_field => { "itential.process" => "webserver" } }

    # Strip IPv4-mapped IPv6 prefix
    mutate {
      gsub => ["remote_addr", "^::ffff:", ""]
      rename => {
        "remote_addr"   => "itential.client_ip"
        "remote_user"   => "itential.user"
        "method"        => "itential.http.method"
        "url"           => "itential.http.url"
        "http_version"  => "itential.http.version"
        "status"        => "itential.http.status"
        "result_length" => "itential.http.response_bytes"
        "total_time_ms" => "itential.http.duration_ms"
      }
    }

    mutate {
      convert => {
        "itential.http.status"         => "integer"
        "itential.http.response_bytes" => "integer"
        "itential.http.duration_ms"    => "float"
      }
    }

    # Extract IAP job ID from request URL
    if [itential.http.url] =~ "/jobs/" {
      grok {
        match => { "itential.http.url" => "/jobs/%{WORD:itential.iap_job_id}" }
      }
      mutate {
        copy => { "itential.iap_job_id" => "itential.job.id" }
      }
    }

    # Tag job submission events
    if [itential.http.url] == "/jobs/start" and [itential.http.method] == "POST" {
      mutate { add_tag => ["job_submitted"] }
    }

    # Tag HTTP errors
    if [itential.http.status] and [itential.http.status] >= 400 and [itential.http.status] < 500 {
      mutate { add_tag => ["http_client_error"] }
    }
    if [itential.http.status] and [itential.http.status] >= 500 {
      mutate { add_tag => ["http_server_error", "automation_failure"] }
    }

    # Webserver uses Apache-style date format
    date {
      match        => ["date", "dd/MMM/yyyy:HH:mm:ss Z"]
      target       => "@timestamp"
      remove_field => ["date"]
    }
  }

  # WorkFlowEngine
  if [itential.process] == "WorkFlowEngine" {
    mutate {
      rename => {
        "job_id"    => "itential.job.id"
        "job_name"  => "itential.job.name"
        "task_id"   => "itential.task.id"
        "task_name" => "itential.task.name"
        "workflow"  => "itential.workflow"
        "status"    => "itential.job.status"
        "duration"  => "itential.job.duration_ms"
      }
    }
    if [itential.job.status] == "error" or [itential.job.status] == "failed" {
      mutate { add_tag => ["automation_failure"] }
    }
  }

  # GatewayManager
  # Note: message unwrapping above must run before this block
  if [itential.process] == "GatewayManager" {

    # Extract gateway dispatch UUID
    # This is the cross-boundary correlation key between IAP and IAG5
    if [message] =~ /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/ {
      grok {
        match => { "message" => "%{UUID:itential.job.id}" }
      }
    }

    # Extract gateway name
    if [message] =~ "gateway:" {
      grok {
        match => { "message" => "gateway: %{WORD:itential.gateway.name}" }
      }
    }

    # Extract BullMQ queue name
    if [message] =~ "Adding job to queue" {
      grok {
        match => { "message" => "Adding job to queue: %{GREEDYDATA:itential.bullmq.queue}" }
      }
    }

    # Extract BullMQ queue name and internal job ID
    if [message] =~ "Job added to BullMQ" {
      grok {
        match => { "message" => "Job added to BullMQ: %{GREEDYDATA:itential.bullmq.queue} with id: %{INT:itential.bullmq.job_id}" }
      }
    }

    if [message] =~ "failed" or [message] =~ "error" {
      mutate { add_tag => ["gateway_connectivity_failure"] }
    }
  }

  # IAG5 (server, client, and runner all emit the same JSON log format)
  if [app] == "itential-gateway-server" or [app] == "itential-gateway-client" or [app] == "itential-gateway-runner" {

    # IAG5 uses 'time' not 'timestamp'
    date {
      match        => ["time", "ISO8601"]
      target       => "@timestamp"
      remove_field => ["time"]
    }

    if [error] {
      mutate {
        rename => { "error" => "[error][message]" }
        add_tag => ["gateway_error"]
      }
    }

    # Extract user, IP, and gRPC method
    if [message] =~ "made request to METHOD" {
      grok {
        match => { "message" => "USER: %{USER:itential.user}@%{IP:itential.client_ip} made request to METHOD: `%{GREEDYDATA:itential.grpc_method}`" }
      }
    }

    # Extract job ID from RunService invocation
    # Named itential.job.id to match GatewayManager field for cross-component correlation
    if [message] =~ "JSON RPC called with Id" {
      grok {
        match => { "message" => "called with Id '%{UUID:itential.job.id}'" }
      }
    }

    # Extract job ID from response message
    if [message] =~ "writing response for message with Id" {
      grok {
        match => { "message" => "writing response for message with Id of '%{UUID:itential.job.id}'" }
      }
    }

    # Extract job ID from ACK message
    if [message] =~ "received ACK for message Id" {
      grok {
        match => { "message" => "received ACK for message Id: '%{UUID:itential.job.id}'" }
      }
    }

    # Extract job ID from other messages containing a bare UUID
    # Only runs if itential.job.id not already set by the patterns above
    if [message] =~ /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/ and ![itential.job.id] {
      grok {
        match => { "message" => "%{UUID:itential.job.id}" }
      }
    }

    # Extract active-requests store path fields
    if [message] =~ "active-requests" {
      grok {
        match => { "message" => "gateway/%{WORD:itential.gateway.name}/active-requests/v1/%{HOSTNAME:itential.gateway.host}/%{UUID:itential.session.id}/%{UUID:itential.job.id}" }
      }
    }

    # Extract command exit status and execution time
    if [message] =~ "command exit status" {
      grok {
        match => { "message" => "command exit status: %{INT:itential.exit_status}, execution time: %{NUMBER:itential.duration_value}%{GREEDYDATA:itential.duration_unit}" }
      }
      mutate {
        convert => {
          "itential.exit_status"    => "integer"
          "itential.duration_value" => "float"
        }
      }
      if [itential.exit_status] != 0 {
        mutate { add_tag => ["command_failure"] }
      }
    }

    # Extract gateway manager connectivity details
    if [message] =~ "gateway manager at" {
      grok {
        match => { "message" => "gateway manager at %{IPORHOST:itential.gateway_manager.host}:%{INT:itential.gateway_manager.port}" }
      }
    }

    if [message] =~ "failed to establish" {
      mutate { add_tag => ["gateway_connectivity_failure"] }
    }

    if [message] =~ "source repository url" {
      grok {
        match => { "message" => "source repository url is %{URI:itential.source.repo_url}" }
      }
    }
  }

  # MongoDB (4.4+ structured JSON format)
  if [app] == "mongodb" {

    # Each log line is a self-contained JSON object
    json {
      source => "message"
      target => "mongodb"
    }

    # Timestamp is nested under t.$date
    date {
      match        => ["[mongodb][t][$date]", "ISO8601"]
      target       => "@timestamp"
      remove_field => ["[mongodb][t]"]
    }

    # Promote and normalize field names
    mutate {
      rename => {
        "[mongodb][s]"   => "log.level"
        "[mongodb][c]"   => "[mongodb][component]"
        "[mongodb][ctx]" => "[mongodb][context]"
        "[mongodb][msg]" => "[mongodb][message]"
      }
    }

    # Expand single-letter severity codes to readable names
    if [log.level] == "F" { mutate { replace => { "log.level" => "fatal"   } } }
    if [log.level] == "E" { mutate { replace => { "log.level" => "error"   } } }
    if [log.level] == "W" { mutate { replace => { "log.level" => "warning" } } }
    if [log.level] == "I" { mutate { replace => { "log.level" => "info"    } } }
    if [log.level] =~ /^D/ { mutate { replace => { "log.level" => "debug"  } } }

    # durationMillis is present on any operation that exceeded slowOpThresholdMs.
    # Check before serializing attr to a string.
    if [mongodb][attr][durationMillis] {
      mutate {
        add_tag => ["slow_query"]
        copy    => { "[mongodb][attr][durationMillis]" => "[mongodb][duration_ms]" }
      }
      mutate {
        convert => { "[mongodb][duration_ms]" => "integer" }
      }
    }

    if [log.level] in ["error", "fatal"] {
      mutate { add_tag => ["mongodb_error"] }
    }

    # Serialize attr to a JSON string to prevent dynamic mapping conflicts.
    # The attr structure varies widely across MongoDB log message types and will
    # cause Elasticsearch document_parsing_exception errors if indexed as an object.
    ruby {
      code => '
        attr = event.get("[mongodb][attr]")
        event.set("[mongodb][attr]", attr.to_json) if attr
      '
    }
  }

  # etcd (3.4+ structured JSON format)
  if [app] == "etcd" {

    # Each log line is a self-contained JSON object
    json {
      source => "message"
      target => "etcd"
    }

    date {
      match        => ["[etcd][ts]", "ISO8601"]
      target       => "@timestamp"
      remove_field => ["[etcd][ts]"]
    }

    mutate {
      rename => {
        "[etcd][level]" => "log.level"
        "[etcd][msg]"   => "message"
      }
    }

    if [etcd][error] or [log.level] in ["error", "panic", "fatal"] {
      mutate { add_tag => ["etcd_error"] }
    }
  }

  # -------------------------------------------------------
  # Redis server logs
  # Format: PID:ROLE DD Mon YYYY HH:MM:SS.mmm LEVEL message
  # ROLE: M=master  S=replica  C=child
  # LEVEL: * notice  # warning  - verbose  . debug
  # -------------------------------------------------------
  if [app] == "redis" {

    grok {
      match => {
        "message" => "(?<redis_pid>\d+):(?<redis_role>[A-Z]) (?<redis_ts>\d{1,2} \w{3} \d{4} \d{2}:\d{2}:\d{2}\.\d{3}) (?<redis_level>[.*#\-]) (?<redis_msg>.+)"
      }
    }

    # Normalize level char to readable name — stored as log.level for consistency
    # with every other component in this pipeline (Platform, Gateway, MongoDB, etcd)
    if [redis_level] == "#" {
      mutate { add_field => { "log.level" => "warning" } }
    } else if [redis_level] == "*" {
      mutate { add_field => { "log.level" => "notice" } }
    } else if [redis_level] == "-" {
      mutate { add_field => { "log.level" => "verbose" } }
    } else if [redis_level] == "." {
      mutate { add_field => { "log.level" => "debug" } }
    }

    # Normalize role char to readable name
    if [redis_role] == "M" {
      mutate { replace => { "redis_role" => "master" } }
    } else if [redis_role] == "S" {
      mutate { replace => { "redis_role" => "replica" } }
    } else if [redis_role] == "C" {
      mutate { replace => { "redis_role" => "child" } }
    }

    date {
      match        => ["redis_ts", "dd MMM yyyy HH:mm:ss.SSS"]
      timezone     => "{{ logstash_redis_log_timezone }}"
      target       => "@timestamp"
      remove_field => ["redis_ts", "redis_level"]
    }

    # Tag replication events
    if [redis_msg] =~ /(?i)(SYNC|PSYNC|partial resync|full resync|replica|replication|connected to master|master<->replica)/ {
      mutate { add_tag => ["redis_replication"] }
    }

    # Tag persistence events
    if [redis_msg] =~ /(?i)(AOF|RDB|BGSAVE|BGREWRITEAOF|rewrite|background saving|DB saved on disk|background append only)/ {
      mutate { add_tag => ["redis_persistence"] }
    }

    # Tag memory pressure
    if [redis_msg] =~ /(?i)(out of memory|OOM|maxmemory|[Ee]vict)/ {
      mutate { add_tag => ["redis_memory_pressure"] }
    }

    # Tag connection events
    if [redis_msg] =~ /(?i)(max number of clients|connection refused|connection reset|Too many)/ {
      mutate { add_tag => ["redis_connection_event"] }
    }

    # Tag lifecycle events
    if [redis_msg] =~ /(?i)(Ready to accept connections|User requested shutdown|Server initialized|Saving the final RDB)/ {
      mutate { add_tag => ["redis_lifecycle"] }
    }

    if [log.level] == "warning" {
      mutate { add_tag => ["redis_error"] }
    }

    mutate {
      rename => { "redis_msg" => "message" }
    }
  }

  # -------------------------------------------------------
  # Redis Sentinel logs — same format, role always X
  # -------------------------------------------------------
  if [app] == "redis-sentinel" {

    grok {
      match => {
        "message" => "(?<redis_pid>\d+):(?<redis_role>[A-Z]) (?<redis_ts>\d{1,2} \w{3} \d{4} \d{2}:\d{2}:\d{2}\.\d{3}) (?<redis_level>[.*#\-]) (?<redis_msg>.+)"
      }
    }

    if [redis_level] == "#" {
      mutate { add_field => { "log.level" => "warning" } }
    } else if [redis_level] == "*" {
      mutate { add_field => { "log.level" => "notice" } }
    } else if [redis_level] == "-" {
      mutate { add_field => { "log.level" => "verbose" } }
    } else if [redis_level] == "." {
      mutate { add_field => { "log.level" => "debug" } }
    }

    if [redis_role] == "X" {
      mutate { replace => { "redis_role" => "sentinel" } }
    }

    date {
      match        => ["redis_ts", "dd MMM yyyy HH:mm:ss.SSS"]
      timezone     => "{{ logstash_redis_log_timezone }}"
      target       => "@timestamp"
      remove_field => ["redis_ts", "redis_level"]
    }

    # Tag failover events
    if [redis_msg] =~ /(?i)(switch-master|failover|elected-leader|new epoch|Sentinel agreed)/ {
      mutate { add_tag => ["sentinel_failover"] }
    }

    # Tag instance state changes
    if [redis_msg] =~ /\+(sdown|odown)|\-(sdown|odown)/ {
      mutate { add_tag => ["sentinel_state_change"] }
    }

    # Extract old→new master IPs from switch-master events
    if [redis_msg] =~ /switch-master/ {
      grok {
        match => {
          "redis_msg" => "switch-master %{WORD:sentinel_master_name} %{IP:sentinel_old_master_ip} %{INT:sentinel_old_master_port} %{IP:sentinel_new_master_ip} %{INT:sentinel_new_master_port}"
        }
      }
    }

    if [log.level] == "warning" {
      mutate { add_tag => ["redis_error"] }
    }

    mutate {
      rename => { "redis_msg" => "message" }
    }
  }

  # Syslog
  if [app] == "syslog" {
    grok {
      match => { "message" => "%{SYSLOGTIMESTAMP:syslog_timestamp} %{SYSLOGHOST:syslog_host} %{GREEDYDATA:syslog_message}" }
    }
    date {
      match        => ["syslog_timestamp", "MMM  d HH:mm:ss", "MMM dd HH:mm:ss"]
      timezone     => "{{ logstash_syslog_timezone }}"
      target       => "@timestamp"
      remove_field => ["syslog_timestamp"]
    }
  }

  # Normalize ISO8601 timestamp
  # Guarded so it only runs on events that have a timestamp field
  if [timestamp] {
    date {
      match        => ["timestamp", "ISO8601"]
      target       => "@timestamp"
      remove_field => ["timestamp"]
    }
  }

  # Record Logstash ingest time for pipeline lag diagnostics
  ruby {
    code => "event.set('event.ingested', Time.now.utc.iso8601(3))"
  }
}

output {
  # Route automation failures to dedicated index for alerting
  if "automation_failure" in [tags] {
    elasticsearch {
      hosts    => {{ logstash_elasticsearch_hosts | to_json }}
      index    => "itential-failures-%{+yyyy.MM.dd}"
      user     => "logstash_writer"
      password => "${ELASTIC_PASSWORD}"
{% if logstash_tls_enabled | bool %}
      ssl_certificate_authorities => ["{{ logstash_tls_ca_cert_dest }}"]
{% endif %}
    }
  }

  # All logs routed by app name
  elasticsearch {
    hosts    => {{ logstash_elasticsearch_hosts | to_json }}
    index    => "itential-logs-%{app}-%{+yyyy.MM.dd}"
    user     => "logstash_writer"
    password => "${ELASTIC_PASSWORD}"
{% if logstash_tls_enabled | bool %}
    ssl_certificate_authorities => ["{{ logstash_tls_ca_cert_dest }}"]
{% endif %}
  }
{% if logstash_loki_enabled | bool %}
{% for loki_app in logstash_loki_apps %}

  # {{ loki_app }} logs → Loki
  if [app] == "{{ loki_app }}" {
    loki {
      url            => "{{ logstash_loki_url }}"
      message_field  => "message"
      include_fields => ["app", "environment", "hostname"]
      batch_size     => {{ logstash_loki_batch_size }}
      batch_wait     => {{ logstash_loki_batch_wait }}
    }
  }
{% endfor %}
{% endif %}
}
